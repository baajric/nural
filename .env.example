# Copy this file to .env.local and fill in the values.

# Supabase project URL and anon (public) key: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional, local development only: lets the app call Gemini directly instead of going
# through the reflection Edge Function. Leave empty when the function is deployed,
# because anything prefixed EXPO_PUBLIC_ is shipped inside the app.
EXPO_PUBLIC_GEMINI_API_KEY=
